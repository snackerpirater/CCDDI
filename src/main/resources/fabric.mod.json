{
  "schemaVersion": 1,
  "id": "ccddi",
  "version": "${version}",
  "name": "CCDDI",
  "description": "CCDDI, or Customizable Clientside Directional Damage Indicator, adds a simple, configurable, and reliable damage indicator to your heads-up-display. ",
  "authors": [],
  "contact": {
    "repo": "https://github.com/SnackerPirater/ccddi"
  },
  "license": "MIT",
  "icon": "assets/ccddi/icon.png",
  "environment": "client",
  "accessWidener": "ccddi.accesswidener",
  "entrypoints": {
    "client": [
      "com.snackpirate.ccddi.client.CCDDIClient"
    ],
    "modmenu": [
      "com.snackpirate.ccddi.Config"
    ]
  },
  "mixins": [
    "ccddi.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.6.6+1.21.5-fabric",
    "modmenu": ">=14.0.0-rc.2"
  }
}
